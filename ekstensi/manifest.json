{
  "manifest_version": 3,
  "name": "AuroraMaps BHUMI Bridge",
  "version": "1.1.0",
  "description": "Menghubungkan AuroraMaps (GitHub Pages & Blogger) ke halaman pendamping BHUMI supaya cek bidang, zona RTRW, dan Analisa jalan normal di komputer mana pun — tanpa memasang aplikasi PC.",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": [
    "https://bhumi.atrbpn.go.id/*",
    "https://riacaya.github.io/*",
    "https://auroramaps.blogspot.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://bhumi.atrbpn.go.id/*"],
      "js": ["sidecar-inject.js", "bhumi-main-adapter.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bhumi.atrbpn.go.id/*"],
      "js": ["bhumi-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://riacaya.github.io/*", "https://auroramaps.blogspot.com/*"],
      "js": ["page-shim.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://riacaya.github.io/*", "https://auroramaps.blogspot.com/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
