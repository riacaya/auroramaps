{
  "manifest_version": 3,
  "name": "AuroraMaps BHUMI Bridge",
  "version": "1.2.0",
  "description": "Meneruskan identifikasi persil dari AuroraMaps ke tab BHUMI yang sedang login.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://bhumi.atrbpn.go.id/*",
    "https://riacaya.github.io/*",
    "http://127.0.0.1:8321/*",
    "http://localhost:8321/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8321/*", "http://localhost:8321/*", "https://riacaya.github.io/*"],
      "js": ["app-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://bhumi.atrbpn.go.id/*"],
      "js": ["bhumi-content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://bhumi.atrbpn.go.id/*"],
      "js": ["bhumi-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
